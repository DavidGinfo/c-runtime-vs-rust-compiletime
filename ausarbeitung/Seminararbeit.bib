@misc{baker_memory_2023,
	title = {Memory {Safety}: {An} {Explainer}},
	shorttitle = {Memory {Safety}},
	url = {https://cset.georgetown.edu/article/memory-safety-an-explainer/},
	abstract = {Memory safety issues remain endemic in cybersecurity and are often seen as a never-ending source of cyber vulnerabilities. Recently the topic has increased in prominence with the White House Office of the National Cyber Director (ONCD) releasing a request for comments on how to strengthen the open-source ecosystem. But what exactly is memory safety? This blog describes the historical antecedents in computing that helped create one aspect of today’s insecure cyber ecosystem. There will be no quick fixes, but there is encouraging progress towards addressing these long-standing security issues.},
